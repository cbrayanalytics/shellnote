#!/usr/bin/env bash
set -u
set -o pipefail
umask 077

die() { printf 'shellnote: %s\n' "$*" >&2; exit 1; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }
use_color() { [ -z "${NO_COLOR+x}" ] && [ "${TERM:-dumb}" != dumb ]; }
info() {
    local prefix=''
    [ "${NOTE_EMOJI:-0}" != 1 ] || prefix='📝 '
    if [ -t 1 ] && use_color; then
        printf '\033[32m%s%s\033[0m\n' "$prefix" "$*"
    else
        printf '%s%s\n' "$prefix" "$*"
    fi
}
usage() {
    printf '%s\n' \
        'shellnote — private Markdown notes in your terminal' \
        '' \
        'Usage: shellnote [command]' \
        '  (no command)       Browse and edit notes' \
        '  init [--git]           Initialize notes storage (optionally Git)' \
        '  new TITLE...           Create and edit a note' \
        '  edit [MATCH...]        Edit the note whose title or path matches' \
        '  last                   Edit the most recently modified note at its end' \
        '  show MATCH...          Print the note whose title or path matches' \
        '  CMD | new TITLE...     Create a note from piped output without the editor' \
        '  CMD | add [MATCH...]   Append piped output to a matching or the last note' \
        '  list [--tag TAG]       List titles and paths, recently modified first' \
        '  find [-p] TEXT...      Search literally, ignoring case unless TEXT has capitals' \
        '                         -p, --print prints matches instead of opening a picker' \
        '  tags [TAG]             Browse tags or notes with an exact tag' \
        '  commit MESSAGE...      Commit Markdown notes locally' \
        '  push                   Push to the configured upstream' \
        '  help, -h, --help       Show this help (COMMAND -h shows its usage)' \
        '' \
        'Words need no quotes: shellnote new case 04512 nginx 502s' \
        'MATCH words must all appear in a title or path, ignoring case.' \
        'Put -- before text that starts with -: shellnote find -- --force' \
        '' \
        'NOTES_DIR overrides ~/.notes. NOTE_EMOJI=1 enables icons.' \
        'NO_COLOR disables color. Notes are private files, not encrypted.'
    printf '%s\n' 'Dependencies: Bash 3.2+, Neovim (nvim), fzf, ripgrep (rg); Git is optional.'
}
stat_style=''
# Sets metadata to "uid mode"; the stat flavor is probed once because the failed probe costs a process per call.
file_metadata() {
    if [ -z "$stat_style" ]; then
        if stat -c %u -- / >/dev/null 2>&1; then stat_style=gnu; else stat_style=bsd; fi
    fi
    if [ "$stat_style" = gnu ]; then metadata=$(stat -c '%u %a' -- "$1"); else metadata=$(stat -f '%u %Lp' -- "$1"); fi
}
check_private() {
    local metadata owner permissions
    file_metadata "$1" || die "cannot inspect: $1"
    owner=${metadata%% *}
    permissions=${metadata#* }
    [ "$owner" = "$UID" ] || die "not owned by your user: $1"
    [ "$permissions" = "$2" ] || die "expected permissions 0$2: $1 (currently $permissions)"
}
resolve_notes_dir() {
    notes_dir=${NOTES_DIR:-"$HOME/.notes"}
    case "$notes_dir" in /*) ;; *) notes_dir="$PWD/$notes_dir";; esac
    while [ "$notes_dir" != / ] && [ "${notes_dir%/}" != "$notes_dir" ]; do notes_dir=${notes_dir%/}; done
    case "$notes_dir" in *$'\n'*|*$'\r'*) die 'storage directory cannot contain line breaks';; esac
    local component=$notes_dir
    while [ "$component" != / ]; do
        if [ -L "$component" ]; then
            case "$component" in /tmp|/var|/etc) ;; *) die "symlink storage path: $component";; esac
        fi
        component=${component%/*}
        [ -n "$component" ] || component=/
    done
}
ensure_notes_dir() {
    resolve_notes_dir
    [ ! -L "$notes_dir" ] || die "symlink storage root: $notes_dir"
    if [ ! -e "$notes_dir" ]; then
        mkdir -p -- "$notes_dir" || die "cannot create storage: $notes_dir"
    fi
    [ -d "$notes_dir" ] || die "not a directory: $notes_dir"
    check_private "$notes_dir" 700
    notes_dir=$(CDPATH='' cd -- "$notes_dir" && pwd -P) || exit 1
    export NOTES_DIR="$notes_dir"
}
validate_note_location() {
    local candidate=$1 parent
    [ -d "$notes_dir" ] && [ ! -L "$notes_dir" ] || die "unsafe storage root: $notes_dir"
    check_private "$notes_dir" 700
    case "$candidate" in "$notes_dir"/*.md) ;; *) die "not a Markdown note inside storage: $candidate";; esac
    case "/${candidate#"$notes_dir"/}/" in */../*|*/./*) die "unsafe note path: $candidate";; esac
    [ ! -L "$candidate" ] || die "symlink note: $candidate"
    [ -f "$candidate" ] || die "not a regular note: $candidate"
    parent=${candidate%/*}
    while [ "$parent" != "$notes_dir" ]; do
        [ "$parent" != / ] && [ ! -L "$parent" ] || die "unsafe note directory: $parent"
        check_private "$parent" 700
        parent=${parent%/*}
    done
}
validate_note() {
    validate_note_location "$1"
    check_private "$1" 600
}
edit_note() {
    local target=$1 line=$2 result=0
    require_command nvim
    validate_note "$target"
    nvim -n -i NONE \
        --cmd 'set noswapfile nobackup nowritebackup noundofile shada=' \
        --cmd 'autocmd BufReadPre,BufNewFile * setlocal noswapfile noundofile | set nobackup nowritebackup shada=' \
        -c 'set noswapfile nobackup nowritebackup noundofile shada=' \
        "+$line" -- "$target" || result=$?
    validate_note_location "$target"
    local metadata
    file_metadata "$target" || exit 1
    [ "${metadata%% *}" = "$UID" ] || die "editor changed note ownership: $target"
    chmod 600 "$target" || die "cannot restore private note permissions: $target"
    check_private "$target" 600
    return "$result"
}
stdin_piped() { [ -p /dev/stdin ] || [ -f /dev/stdin ]; }
cleanup_temp() {
    [ -z "${picker_map:-}" ] || rm -f -- "$picker_map"
    [ -z "${capture_file:-}" ] || rm -f -- "$capture_file"
}
# Copies stdin to a private file first so empty or failed input changes no note.
capture_stdin() {
    capture_file=$(mktemp "$notes_dir/.capture.XXXXXXXX") || die 'cannot capture input'
    trap cleanup_temp EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    cat > "$capture_file" || die 'cannot read input'
    [ -s "$capture_file" ] || die 'no input to add'
}
# Appends the captured input in a fence longer than any backtick run inside it.
append_capture() {
    local target=$1 longest fence='```'
    validate_note "$target"
    longest=$(LC_ALL=C tr -c '`' '\n' < "$capture_file" | awk '{ if (length > m) m = length } END { print m + 0 }') \
        || die 'cannot inspect input'
    while [ "${#fence}" -le "$longest" ]; do fence="$fence\`"; done
    # A note without a final newline would otherwise glue its last line to the fence.
    [ -z "$(tail -c 1 -- "$target")" ] || fence=$'\n'"$fence"
    {
        printf '\n%s\n' "$fence"
        cat -- "$capture_file"
        [ -z "$(tail -c 1 -- "$capture_file")" ] || printf '\n'
        printf '%s\n' "${fence#$'\n'}"
    } >> "$target" || die "cannot append to note: $target"
    check_private "$target" 600
}
create_note() {
    local title=$1 capture=${2:-false} slug filename stamp
    [ -n "$title" ] || die 'new requires a nonempty title'
    case "$title" in *$'\n'*|*$'\r'*) die 'title must fit on one line';; esac
    [ "$capture" = true ] || require_command nvim
    ensure_notes_dir
    [ "$capture" = false ] || capture_stdin
    slug=$(printf '%s' "$title" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C tr -cs 'a-z0-9' '-' | cut -c 1-48)
    slug=${slug#-}; slug=${slug%-}
    [ -n "$slug" ] || slug=note
    stamp=$(date -u '+%Y%m%dT%H%M%SZ') || exit 1
    filename=$(mktemp "$notes_dir/$stamp-$slug.XXXXXXXX") || die 'cannot allocate a note'
    # Reserve the final name without overwriting an existing note.
    if ! ln -- "$filename" "$filename.md"; then
        rm -f -- "$filename"
        die 'cannot allocate Markdown filename'
    fi
    rm -f -- "$filename" || exit 1
    filename=$filename.md
    if [ "$capture" = true ]; then
        printf '# %s\n' "$title" > "$filename" || die "cannot write note: $filename"
        append_capture "$filename"
        rel_label "$filename"
        info "Created: $REPLY"
        return
    fi
    printf '# %s\n\n' "$title" > "$filename" || die "cannot write note: $filename"
    edit_note "$filename" 1
}
# Consumes leading options that appear in the usage text and sets option_count and opt_*.
# Unknown options fail so a typo is never saved as a title or searched as text.
parse_options() {
    local usage=$1
    shift
    option_count=0; opt_git=false; opt_print=false; opt_tag=''
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -h|--help) printf 'usage: shellnote %s\n' "$usage"; exit 0;;
            --) option_count=$((option_count + 1)); return 0;;
            --git) [[ "$usage" == *--git* ]] || unknown_option "$1" "$usage"; opt_git=true;;
            -p|--print) [[ "$usage" == *--print* ]] || unknown_option "$1" "$usage"; opt_print=true;;
            --tag)
                [[ "$usage" == *--tag* ]] || unknown_option "$1" "$usage"
                [ "$#" -ge 2 ] || die "usage: shellnote $usage"
                opt_tag=$2; shift; option_count=$((option_count + 1));;
            -?*) unknown_option "$1" "$usage";;
            *) return 0;;
        esac
        shift; option_count=$((option_count + 1))
    done
}
unknown_option() {
    die "unknown option: $1 (usage: shellnote $2; put -- before text starting with -)"
}
sanitize() {
    LC_ALL=C tr -d '\000-\010\013\014\016-\037\177'
}
# Sets REPLY instead of printing so hot loops avoid a subshell per label.
label() {
    local LC_ALL=C
    REPLY=${1//[$'\t\r\n']/ }
    REPLY=${REPLY//[[:cntrl:]]/}
}
rel_label() { label "${1#"$notes_dir"/}"; }
collect_notes() {
    note_paths=()
    local path
    while IFS= read -r -d '' path; do
        validate_note "$path"
        note_paths+=("$path")
    done < <(find "$notes_dir" -name .git -prune -o -type f -name '*.md' -print0 | LC_ALL=C sort -z)
}
# Searches note_paths in bounded batches so large collections stay under ARG_MAX.
rg_notes() {
    local i status=1 result
    for ((i=0; i<${#note_paths[@]}; i+=256)); do
        result=0
        rg --no-config --no-ignore --text --color=never --sort path --with-filename --null --no-heading \
            "$@" -- "${note_paths[@]:i:256}" || result=$?
        case "$result" in 0) status=0;; 1) ;; *) return 2;; esac
    done
    return "$status"
}
# Fills rg_paths and rg_rest from "path\0rest\n" records.
# Process substitution hides the exit status, so a trailing record with an empty path carries it.
search_notes() {
    local error=$1 path rest status=2
    shift
    rg_paths=(); rg_rest=()
    while IFS= read -r -d '' path && IFS= read -r rest; do
        if [ -z "$path" ]; then status=$rest; break; fi
        rg_paths+=("$path"); rg_rest+=("$rest")
    done < <(rg_notes "$@"; printf '\0%s\n' "$?")
    case "$status" in 0|1) ;; *) die "$error";; esac
}
normalize_tag() {
    REPLY=${1#\#}
    [[ "$REPLY" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die 'invalid tag: use letters, digits, underscores, or hyphens'
}
# Narrows note_paths to notes containing the exact tag.
filter_by_tag() {
    local i
    search_notes 'tag search failed' --count -e "(^|[[:space:]])#$1([^A-Za-z0-9_-]|$)"
    note_paths=()
    for ((i=0; i<${#rg_paths[@]}; i++)); do note_paths+=("${rg_paths[i]}"); done
}
add_note_result() {
    local rel
    rel_label "$1"; rel=$REPLY
    if note_title "$1"; then REPLY="$REPLY  ($rel)"; fi
    result_paths+=("$1"); result_lines+=(1); result_labels+=("$REPLY")
}
# Reorders note_paths by modification time, newest first, so active cases sit at the top.
# Ties keep path order. Batched like rg_notes to stay under ARG_MAX.
sort_recent() {
    local i index mtime order=''
    local -a mtimes=() sorted=()
    [ "${#note_paths[@]}" -gt 1 ] || return 0
    file_metadata "${note_paths[0]}" || die "cannot inspect: ${note_paths[0]}"
    for ((i=0; i<${#note_paths[@]}; i+=256)); do
        if [ "$stat_style" = gnu ]; then
            order=$(stat -c %Y -- "${note_paths[@]:i:256}") || die 'cannot read modification times'
        else
            order=$(stat -f %m -- "${note_paths[@]:i:256}") || die 'cannot read modification times'
        fi
        while IFS= read -r mtime; do mtimes+=("$mtime"); done <<< "$order"
    done
    [ "${#mtimes[@]}" = "${#note_paths[@]}" ] || die 'cannot read modification times'
    while IFS=' ' read -r mtime index; do
        sorted+=("${note_paths[index]}")
    done < <(for ((i=0; i<${#mtimes[@]}; i++)); do printf '%s %s\n' "${mtimes[i]}" "$i"; done | sort -k1,1nr -k2,2n)
    note_paths=("${sorted[@]}")
}
picker() (
    unset FZF_DEFAULT_OPTS FZF_DEFAULT_OPTS_FILE FZF_DEFAULT_COMMAND
    export SHELL="$BASH"
    local color=--color=16
    use_color || color=--no-color
    fzf --height=80% --layout=reverse --border "$color" "$@"
)
select_note() {
    local action=${1:-edit} i selected result=0 id preview quoted_bash quoted_app quoted_map
    if [ "${#result_paths[@]}" = 0 ]; then info 'No matches.'; return 0; fi
    require_command fzf
    picker_map=$(mktemp "${TMPDIR:-/tmp}/shellnote-picker.XXXXXXXX") || die 'cannot create picker metadata'
    trap cleanup_temp EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    for ((i=0; i<${#result_paths[@]}; i++)); do
        printf '%s\0%s\0' "${result_paths[i]}" "${result_lines[i]}" >> "$picker_map" || exit 1
    done
    printf -v quoted_bash '%q' "$BASH"
    printf -v quoted_app '%q' "$app_path"
    printf -v quoted_map '%q' "$picker_map"
    preview="$quoted_bash $quoted_app __preview $quoted_map {1}"
    selected=$(
        for ((i=0; i<${#result_paths[@]}; i++)); do
            printf '%s\t%s\n' "$((i+1))" "${result_labels[i]}"
        done | picker --delimiter=$'\t' --with-nth=2.. --prompt='notes> ' \
            --preview "$preview" --preview-window=right:55%:wrap
    ) || result=$?
    rm -f -- "$picker_map"; picker_map=''
    case "$result" in 1|130) return 0;; 0) ;; *) die "picker failed (exit $result)";; esac
    id=${selected%%$'\t'*}
    [[ "$id" =~ ^[1-9][0-9]*$ ]] && [ "${#id}" -lt 10 ] || die 'invalid picker selection'
    [ "$id" -le "${#result_paths[@]}" ] || die 'invalid picker selection'
    i=$((id-1))
    open_result "$action" "$i"
}
open_result() {
    case "$1" in
        show) validate_note "${result_paths[$2]}"; sanitize < "${result_paths[$2]}";;
        add) append_capture "${result_paths[$2]}"; info "Added to: ${result_labels[$2]}";;
        *) edit_note "${result_paths[$2]}" "${result_lines[$2]}";;
    esac
}
# Acts on the most recently modified note; editing starts at its last line to resume work.
open_latest() {
    ensure_notes_dir
    collect_notes
    [ "${#note_paths[@]}" -gt 0 ] || die 'no notes yet'
    sort_recent
    result_paths=(); result_lines=(); result_labels=()
    add_note_result "${note_paths[0]}"
    result_lines[0]='$'
    open_result "$1" 0
}
preview_note() {
    local map=$1 id=$2 path line i=0
    [[ "$id" =~ ^[1-9][0-9]*$ ]] && [ "${#id}" -lt 10 ] || die 'invalid preview selection'
    [ -f "$map" ] && [ ! -L "$map" ] || die 'invalid preview metadata'
    check_private "$map" 600
    while IFS= read -r -d '' path && IFS= read -r -d '' line; do
        i=$((i+1))
        if [ "$i" = "$id" ]; then
            validate_note "$path"
            sanitize < "$path"
            return
        fi
    done < "$map"
    die 'preview selection not found'
}
browse_notes() {
    local i
    ensure_notes_dir
    collect_notes
    if [ "${#note_paths[@]}" = 0 ]; then info 'No notes yet. Create one: shellnote new Title'; return; fi
    sort_recent
    result_paths=(); result_lines=(); result_labels=()
    for ((i=0; i<${#note_paths[@]}; i++)); do add_note_result "${note_paths[i]}"; done
    select_note
}
# Sets REPLY to the note's "# " heading, falling back to its relative path with status 1.
note_title() {
    local first_line=''
    IFS= read -r first_line < "$1" || true
    case "$first_line" in
        '# '*) label "${first_line#\# }";;
        *) rel_label "$1"; return 1;;
    esac
}
list_notes() {
    local tag=${1:-} i title_width=5 path_width=4 title_rule path_rule
    local -a list_paths=() list_titles=()
    ensure_notes_dir
    collect_notes
    if [ -n "$tag" ]; then
        require_command rg
        normalize_tag "$tag"
        filter_by_tag "$REPLY"
    fi
    sort_recent
    for ((i=0; i<${#note_paths[@]}; i++)); do
        note_title "${note_paths[i]}"
        list_titles+=("$REPLY")
        [ "${#REPLY}" -le "$title_width" ] || title_width=${#REPLY}
        rel_label "${note_paths[i]}"
        list_paths+=("$REPLY")
        [ "${#REPLY}" -le "$path_width" ] || path_width=${#REPLY}
    done
    if [ -t 1 ] && use_color; then
        printf -v title_rule '%*s' "$title_width" ''
        printf -v path_rule '%*s' "$path_width" ''
        printf '\033[1;32m%-*s\033[0m  \033[2m%s\033[0m\n' "$title_width" TITLE PATH
        printf '\033[2m%s  %s\033[0m\n' "${title_rule// /-}" "${path_rule// /-}"
        for ((i=0; i<${#list_paths[@]}; i++)); do
            printf '\033[1m%-*s\033[0m  \033[2m%s\033[0m\n' "$title_width" "${list_titles[i]}" "${list_paths[i]}"
        done
    else
        for ((i=0; i<${#list_paths[@]}; i++)); do
            printf '%s\t%s\n' "${list_titles[i]}" "${list_paths[i]}"
        done
    fi
}
find_notes() {
    local query=$1 print_matches=${2:-false} i line content
    [ -n "$query" ] || die 'find requires nonempty text'
    require_command rg
    ensure_notes_dir
    collect_notes
    search_notes 'search failed' -n -F --smart-case -e "$query"
    result_paths=(); result_lines=(); result_labels=(); result_contents=()
    for ((i=0; i<${#rg_paths[@]}; i++)); do
        line=${rg_rest[i]%%:*}; content=${rg_rest[i]#*:}
        result_paths+=("${rg_paths[i]}"); result_lines+=("$line"); result_contents+=("$content")
        # Print mode never shows picker labels, so skip building them.
        if [ "$print_matches" != true ]; then
            rel_label "${rg_paths[i]}:$line: $content"
            result_labels+=("$REPLY")
        fi
    done
    if [ "$print_matches" = true ]; then
        print_search_results "$query"
    else
        select_note
    fi
}
# Fills heading_lines and heading_texts with one note's Markdown headings in line order.
load_headings() {
    local records result=0 record
    heading_lines=(); heading_texts=()
    records=$(rg --no-config --no-ignore --text --color=never --no-filename -n -e '^#{1,6}[[:space:]]' -- "$1") || result=$?
    case "$result" in 0) ;; 1) return 0;; *) die "heading search failed: $1";; esac
    while IFS= read -r record; do
        heading_lines+=("${record%%:*}"); heading_texts+=("${record#*:}")
    done <<< "$records"
}
# Sets REPLY to a window of text around the first query match.
focused_preview() {
    local text=$1 query=$2 width=$3 prefix start=0
    if [ "${#text}" -le "$width" ]; then
        REPLY=$text
    else
        prefix=${text%%"$query"*}
        # Smart-case can match with different case, so retry the offset on lowercased copies.
        if [ "$prefix" = "$text" ]; then
            prefix=$(printf '%s' "$text" | LC_ALL=C tr '[:upper:]' '[:lower:]')
            prefix=${prefix%%"$(printf '%s' "$query" | LC_ALL=C tr '[:upper:]' '[:lower:]')"*}
        fi
        start=$((${#prefix} - width / 3))
        [ "$start" -ge 0 ] || start=0
        REPLY=${text:start:width}
        [ "$start" = 0 ] || REPLY="…$REPLY"
        [ $((start + width)) -ge "${#text}" ] || REPLY="$REPLY…"
    fi
    REPLY=${REPLY//[|\`*]/ }
    while [[ "$REPLY" == *'  '* ]]; do REPLY=${REPLY//  / }; done
}
print_search_results() {
    local query=$1 i h=0 path previous_path='' previous_heading='' title heading='' preview_width=88
    local title_on='' path_on='' color_off=''
    if [[ "${COLUMNS:-}" =~ ^[0-9]+$ ]] && [ "$COLUMNS" -lt "$((preview_width + 8))" ]; then
        preview_width=$((COLUMNS - 8))
    fi
    [ "$preview_width" -ge 20 ] || preview_width=20
    if [ -t 1 ]; then
        if use_color; then title_on=$'\033[1;32m'; path_on=$'\033[2m'; color_off=$'\033[0m'; fi
        for ((i=0; i<${#result_paths[@]}; i++)); do
            path=${result_paths[i]}
            if [ "$path" != "$previous_path" ]; then
                note_title "$path"; title=$REPLY
                rel_label "$path"
                [ -z "$previous_path" ] || printf '\n'
                printf '%s# %s%s\n%s%s%s\n' "$title_on" "$title" "$color_off" "$path_on" "$REPLY" "$color_off"
                previous_path=$path
                previous_heading="# $title"
                load_headings "$path"; h=0; heading=''
            fi
            # Matches arrive in line order, so the heading cursor only moves forward.
            while [ "$h" -lt "${#heading_lines[@]}" ] && [ "${heading_lines[h]}" -le "${result_lines[i]}" ]; do
                heading=${heading_texts[h]}; h=$((h+1))
            done
            if [ -n "$heading" ] && [ "$heading" != "$previous_heading" ]; then
                label "$heading"
                printf '\n%s\n' "$REPLY"
                previous_heading=$heading
            fi
            [[ "${result_contents[i]}" =~ ^#{1,6}[[:space:]] ]] && continue
            label "${result_contents[i]}"
            focused_preview "$REPLY" "$query" "$preview_width"
            printf '  %4s  %s\n' "${result_lines[i]}" "$REPLY"
        done
    else
        for ((i=0; i<${#result_paths[@]}; i++)); do
            rel_label "${result_paths[i]}"; path=$REPLY
            label "${result_contents[i]}"
            printf '%s:%s: %s\n' "$path" "${result_lines[i]}" "$REPLY"
        done
    fi
}
# Opens or prints the note matching every term; several matches open the picker.
# Matching only considers collected notes, so no input can reach a path outside storage.
open_match() {
    local action=$1 i path rel haystack term matched exact
    shift
    ensure_notes_dir
    collect_notes
    exact="$notes_dir/$*"
    result_paths=(); result_lines=(); result_labels=()
    for ((i=0; i<${#note_paths[@]}; i++)); do
        if [ "${note_paths[i]}" = "$exact" ]; then add_note_result "$exact"; open_result "$action" 0; return; fi
    done
    sort_recent
    shopt -s nocasematch
    for ((i=0; i<${#note_paths[@]}; i++)); do
        path=${note_paths[i]}; rel=${path#"$notes_dir"/}
        note_title "$path"
        haystack="$REPLY"$'\n'"$rel"
        matched=true
        for term in "$@"; do [[ "$haystack" == *"$term"* ]] || { matched=false; break; }; done
        [ "$matched" = false ] || add_note_result "$path"
    done
    shopt -u nocasematch
    case "${#result_paths[@]}" in
        0) die "no note matches: $*";;
        1) open_result "$action" 0;;
        *) select_note "$action";;
    esac
}
tag_notes() {
    local tag=$1 i result all_tags='' selected
    require_command rg
    ensure_notes_dir
    collect_notes
    if [ -z "$tag" ]; then
        search_notes 'tag search failed' -N -o -e '(^|[[:space:]])#[A-Za-z0-9][A-Za-z0-9_-]*'
        for ((i=0; i<${#rg_rest[@]}; i++)); do all_tags="$all_tags#${rg_rest[i]##*#}"$'\n'; done
        if [ -z "$all_tags" ]; then info 'No tags found.'; return; fi
        require_command fzf
        result=0
        selected=$(printf '%s' "$all_tags" | LC_ALL=C sort -u | picker --prompt='tags> ') || result=$?
        case "$result" in 1|130) return 0;; 0) ;; *) die "tag picker failed (exit $result)";; esac
        tag=$selected
    fi
    normalize_tag "$tag"
    filter_by_tag "$REPLY"
    sort_recent
    result_paths=(); result_lines=(); result_labels=()
    for ((i=0; i<${#note_paths[@]}; i++)); do add_note_result "${note_paths[i]}"; done
    select_note
}
notes_git() (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
        GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_CEILING_DIRECTORIES \
        GIT_DISCOVERY_ACROSS_FILESYSTEM GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT \
        GIT_NAMESPACE GIT_SHALLOW_FILE GIT_REPLACE_REF_BASE GIT_GRAFT_FILE \
        GIT_ICASE_PATHSPECS GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS
    git -C "$notes_dir" "$@"
)
require_notes_repository() {
    require_command git
    [ -d "$notes_dir/.git" ] && [ ! -L "$notes_dir/.git" ] || die 'notes must have their own repository: shellnote init --git'
    check_private "$notes_dir/.git" 700
    local root
    root=$(notes_git rev-parse --show-toplevel 2>/dev/null) || die 'invalid notes repository'
    [ "$root" = "$notes_dir" ] || die 'Git repository root must be the notes directory'
}
init_git() {
    require_command git
    if [ -e "$notes_dir/.git" ] || [ -L "$notes_dir/.git" ]; then
        require_notes_repository
    else
        notes_git init -q || die 'could not initialize notes repository'
        require_notes_repository
    fi
    if [ ! -e "$notes_dir/.gitignore" ] && [ ! -L "$notes_dir/.gitignore" ]; then
        (set -o noclobber; printf '%s\n' '*.swp' '*.swo' '*~' '*.un~' '.DS_Store' > "$notes_dir/.gitignore") || die 'cannot create ignore file'
        notes_git config --local shellnote.ownsIgnore true || die 'cannot record ignore file ownership'
    fi
    info "Notes repository ready: $notes_dir"
}
# Deleted paths are fine to stage; anything still on disk must be a private note.
validate_tracked_note() {
    if [ -e "$notes_dir/$1" ] || [ -L "$notes_dir/$1" ]; then validate_note "$notes_dir/$1"; fi
}
commit_notes() {
    local message=$1 path owns_ignore=false index_result=0
    [ -n "$message" ] || die 'commit requires a nonempty message'
    ensure_notes_dir
    require_notes_repository
    owns_ignore=$(notes_git config --local --bool shellnote.ownsIgnore 2>/dev/null) || owns_ignore=false
    notes_git diff --cached --quiet -- || index_result=$?
    [ "$index_result" -le 1 ] || die 'cannot inspect the Git index'
    while IFS= read -r -d '' path; do
        case "$path" in
            *.md) validate_tracked_note "$path";;
            .gitignore) [ "$owns_ignore" = true ] || die 'unrelated staged file: .gitignore';;
            *) die "unrelated staged file: $path";;
        esac
    done < <(notes_git diff --cached --no-renames --name-only -z --)
    collect_notes
    local stage_paths=()
    for path in "${note_paths[@]}"; do stage_paths+=(":(literal)${path#"$notes_dir"/}"); done
    while IFS= read -r -d '' path; do
        case "$path" in
            *.md) validate_tracked_note "$path"; stage_paths+=(":(literal)$path");;
        esac
    done < <(notes_git ls-files --deleted -z --)
    if [ "$owns_ignore" = true ]; then
        [ -f "$notes_dir/.gitignore" ] && [ ! -L "$notes_dir/.gitignore" ] || die 'app-created .gitignore is missing or unsafe'
        check_private "$notes_dir/.gitignore" 600
        stage_paths+=(':(literal).gitignore')
    fi
    if [ "${#stage_paths[@]}" -gt 0 ]; then
        notes_git add -- "${stage_paths[@]}" || die 'could not stage notes'
    fi
    index_result=0
    notes_git diff --cached --quiet -- || index_result=$?
    case "$index_result" in 0) info 'No note changes to commit.'; return 0;; 1) ;; *) die 'cannot inspect staged notes';; esac
    notes_git commit -m "$message"
}
push_notes() {
    ensure_notes_dir
    require_notes_repository
    notes_git push
}
main() {
    local command=${1:-browse}
    [ "$#" = 0 ] || shift
    case "$command" in
        help|--help|-h) [ "$#" = 0 ] || die 'help takes no arguments'; usage;;
        init)
            parse_options 'init [--git]' "$@"; shift "$option_count"
            [ "$#" = 0 ] || die 'usage: shellnote init [--git]'
            [ "$opt_git" = false ] || require_command git
            ensure_notes_dir
            if [ "$opt_git" = true ]; then init_git; else info "Storage ready: $notes_dir"; fi;;
        new)
            parse_options 'new TITLE...' "$@"; shift "$option_count"
            [ "$#" -ge 1 ] || die 'usage: shellnote new TITLE...'
            if stdin_piped; then create_note "$*" true; else create_note "$*"; fi;;
        add)
            parse_options 'add [MATCH...]' "$@"; shift "$option_count"
            stdin_piped || die 'usage: COMMAND | shellnote add [MATCH...]'
            ensure_notes_dir
            capture_stdin
            if [ "$#" = 0 ]; then open_latest add; else open_match add "$@"; fi;;
        last)
            parse_options 'last' "$@"; shift "$option_count"
            [ "$#" = 0 ] || die 'usage: shellnote last'
            open_latest edit;;
        browse) [ "$#" = 0 ] || die 'shellnote takes no arguments without a command'; browse_notes;;
        edit)
            parse_options 'edit [MATCH...]' "$@"; shift "$option_count"
            if [ "$#" = 0 ]; then browse_notes; else open_match edit "$@"; fi;;
        show)
            parse_options 'show MATCH...' "$@"; shift "$option_count"
            [ "$#" -ge 1 ] || die 'usage: shellnote show MATCH...'
            open_match show "$@";;
        list)
            parse_options 'list [--tag TAG]' "$@"; shift "$option_count"
            [ "$#" = 0 ] || die 'usage: shellnote list [--tag TAG]'
            list_notes "$opt_tag";;
        find)
            parse_options 'find [-p|--print] TEXT...' "$@"; shift "$option_count"
            [ "$#" -ge 1 ] || die 'usage: shellnote find [-p|--print] TEXT...'
            find_notes "$*" "$opt_print";;
        tags)
            parse_options 'tags [TAG]' "$@"; shift "$option_count"
            [ "$#" -le 1 ] || die 'usage: shellnote tags [TAG]'
            tag_notes "${1:-}";;
        commit)
            parse_options 'commit MESSAGE...' "$@"; shift "$option_count"
            [ "$#" -ge 1 ] || die 'usage: shellnote commit MESSAGE...'
            commit_notes "$*";;
        push)
            parse_options 'push' "$@"; shift "$option_count"
            [ "$#" = 0 ] || die 'usage: shellnote push'
            push_notes;;
        __preview) [ "$#" = 2 ] || die 'invalid preview arguments'; ensure_notes_dir; preview_note "$1" "$2";;
        *) die "unknown command: $command (see shellnote help)";;
    esac
}
app_path=${BASH_SOURCE[0]}
case "$app_path" in /*) ;; *) app_path="$PWD/$app_path";; esac
main "$@"
